/* =====================================================================
 * app.wxss — 全局样式
 * 暗色"直播间"主题。注意：WXSS 基础库部分版本不支持 CSS 变量，
 * 因此全部使用字面量颜色（与设计文档 4.1 配色一致）。
 * ---------------------------------------------------------------------
 * 主色   #1a1a2e 深空蓝黑     辅助色  #e94560 警示红
 *        #16213e               #f5a623 警示黄
 *        #16c79a 成功绿        #f5c518 金色
 * ===================================================================== */
page {
  background: #1a1a2e;
  color: #eaeaf2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, image {
  box-sizing: border-box;
}

/* ---------- 通用卡片（毛玻璃） ---------- */
.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  padding: 32rpx;
  margin: 24rpx;
}

/* ---------- 按钮 ---------- */
button::after {
  border: none; /* 去掉小程序按钮默认边框 */
}
.btn {
  border: none;
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: #ffffff;
  line-height: 1.4;
  background: linear-gradient(135deg, #e94560, #c23152);
}
.btn-primary {
  width: 100%;
  background: linear-gradient(135deg, #e94560, #c23152);
}
.btn-green {
  width: 100%;
  background: linear-gradient(135deg, #16c79a, #0fa77f);
}
.btn-ghost {
  width: 100%;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #eaeaf2;
}
.btn[disabled],
.btn-ghost[disabled] {
  opacity: 0.4;
}

/* ---------- 标题 ---------- */
.title {
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}
.subtitle {
  font-size: 24rpx;
  color: #9aa0b8;
  text-align: center;
}

.section-hint {
  font-size: 24rpx;
  color: #9aa0b8;
  text-align: center;
  margin: 12rpx 0;
}

/* ---------- 底部操作栏（含安全区适配） ---------- */
.continue-bar {
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}