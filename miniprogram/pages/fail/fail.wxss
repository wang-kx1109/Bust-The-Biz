/* pages/fail/fail.wxss */
.fail-wrap {
  text-align: center;
  padding: 160rpx 48rpx 40rpx;
}
.fail-emoji {
  font-size: 160rpx;
  animation: failShake 0.5s infinite;
}
@keyframes failShake {
  0%   { transform: rotate(0); }
  25%  { transform: rotate(-6deg); }
  50%  { transform: rotate(0); }
  75%  { transform: rotate(6deg); }
  100% { transform: rotate(0); }
}
.fail-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 32rpx;
  color: #e94560;
}
.fail-sub {
  font-size: 30rpx;
  color: #eaeaf2;
  margin-top: 12rpx;
}
.fail-more {
  font-size: 24rpx;
  color: #9aa0b8;
  margin-top: 12rpx;
}

.continue-bar {
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}