/* pages/link/link.wxss — 连线页 */

.link-head {
  text-align: center;
  padding: 24rpx 24rpx 12rpx;
}
.link-title {
  font-size: 34rpx;
  font-weight: 800;
}
.link-sub {
  font-size: 24rpx;
  color: #9aa0b8;
  margin-top: 6rpx;
}
.link-count {
  font-size: 24rpx;
  color: #f5c518;
  margin-top: 8rpx;
}

.link-area {
  position: relative;
  margin: 20rpx 24rpx;
}
.cols {
  display: flex;
  justify-content: space-between;
  position: relative;
}
.col {
  width: 44%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* canvas 铺满连线区，穿透点击 */
.link-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.lcard,
.rcard {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  transition: all 0.15s;
  position: relative;
}
.lcard.selected {
  border-color: #f5c518;
  box-shadow: 0 0 0 4rpx rgba(245, 197, 24, 0.35);
}
.lcard.locked,
.rcard.locked {
  border-color: #16c79a;
  background: rgba(22, 199, 154, 0.15);
  cursor: default;
}

.continue-bar .btn {
  margin-top: 8rpx;
}